# foundry.env.ps1.template - use Claude through Microsoft Foundry (your Azure tenant)
# instead of Anthropic's API. Copy to foundry.env.ps1 and fill in; run.ps1 loads it.
# app.py reads it too, but only quoted  $env:NAME = "value"  lines: keep it to plain
# assignments like the ones below.
#
# Prereq: in Foundry, deploy a Claude model (e.g. claude-opus-5-5 or claude-sonnet-5-5).
# "Hosted on Azure" + Data Zone (US) keeps inference inside Azure's US data zone.
# From the deployment's Details tab, note the resource name and key.
#
# The filled-in foundry.env.ps1 holds a live key. Keep it out of synced folders
# (OneDrive, SharePoint), email and chat. Never put real values in this template.

$env:CLAUDE_CODE_USE_FOUNDRY      = "1"
$env:ANTHROPIC_FOUNDRY_RESOURCE   = "<resource-name>"     # the <name> in https://<name>.services.ai.azure.com
$env:ANTHROPIC_FOUNDRY_API_KEY    = "<resource-key>"      # KEY 1 or KEY 2 from the resource's keys page
$env:CLAUDE_FOUNDRY_DEPLOYMENT    = "claude-sonnet-5-5"   # your DEPLOYMENT name (passed as --model)

# Optional: a separate Azure AI Speech resource for spoken answers. Without these
# two lines, speech uses the Foundry resource and key above.
# $env:SPEECH_RESOURCE = "<speech-resource-name>"
# $env:SPEECH_KEY      = "<speech-resource-key>"

# Keyless (Entra ID) sign-in is not supported by this version: without a key the bot
# fails at start-up, and preflight and spoken answers need the key as well.
